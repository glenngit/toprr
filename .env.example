# Streaming Availability API key (https://docs.movieofthenight.com/guide/authentication)
STREAMING_AVAILABILITY_API_KEY=your-api-key-here

# Optional: TMDB v3 API key — only used to fetch poster images for the web GUI.
TMDB_API_KEY=

# Country to pull Top 10 lists for (ISO 3166-1 alpha-2). Default: us
FEED_COUNTRY=us

# Overseerr / Jellyseerr instance (base URL, no trailing slash) and API key.
# Used to check what already exists and to submit requests. Keep server-side.
SEERR_URL=https://your-seerr-instance.example.com
SEERR_API_KEY=your-seerr-api-key

# Radarr (movies) and Sonarr (TV) backends. Used server-side only to resolve
# live library/download status for the web GUI. Keys are never sent to the browser.
RADARR_URL=https://your-radarr.example.com
RADARR_API_KEY=your-radarr-api-key
SONARR_URL=https://your-sonarr.example.com
SONARR_API_KEY=your-sonarr-api-key

# Web GUI
PORT=9797
LOG_DIR=logs
